# Fault injection: making a dependency fail, stall or lie on purpose.
#
# Two layers: `Rogue` and the Data values mirror the core one for one; the
# module functions are a process-wide runtime on top of one Rogue. Every
# value validates through the core at construction: TypeError for the wrong
# type, RangeError for a value the core's constructor rejects. Time is Integer
# nanoseconds throughout.
module RogueMachines
  VERSION: String

  # Millionths in a whole, the unit a Fraction and a Draw are held in.
  PER_MILLION: Integer

  # Slots a Rogue holds, the width of the armed mask.
  EXPERIMENTS: Integer

  # Longest `expires_in` the runtime arms, in nanoseconds: a day.
  LONGEST_EXPERIMENT: Integer

  # Longest Delay the runtime arms, in nanoseconds: five minutes.
  LONGEST_DELAY: Integer

  # Attempts at a reading against the clock still installed once the
  # runtime's lock is held.
  READINGS: Integer

  class Error < StandardError
  end

  # Raised by a :raise fault in place of the real call.
  class Injected < Error
  end

  # The core's `Slot`: an index in 0...EXPERIMENTS the caller picks. Not an
  # issued id.
  class Slot < ::Data
    attr_reader index: Integer
    def self.new: (Integer index) -> Slot
                | (index: Integer) -> Slot
  end

  # The core's `Fraction`: 0..PER_MILLION millionths.
  class Fraction < ::Data
    NONE: Fraction
    ALL: Fraction
    attr_reader millionths: Integer
    def self.new: (Integer millionths) -> Fraction
                | (millionths: Integer) -> Fraction
    # Whether `draw` falls in this share: `draw.millionths < millionths`.
    def covers?: (Draw draw) -> bool
  end

  # The core's `Draw`: 0...PER_MILLION millionths.
  class Draw < ::Data
    attr_reader millionths: Integer
    def self.new: (Integer millionths) -> Draw
                | (millionths: Integer) -> Draw
  end

  # The core's `Fault::Delay`: `duration` Integer nanoseconds, 0..2**64-1.
  class Delay < ::Data
    attr_reader duration: Integer
    def self.new: (Integer duration) -> Delay
                | (duration: Integer) -> Delay
  end

  # The core's `Fault`: unit variants as symbols, the tuple variant as Delay.
  type fault = :raise | :garble | Delay

  # The core's `Experiment`. `expires_at` is Integer nanoseconds, 0..2**64-1.
  class Experiment < ::Data
    attr_reader fault: fault
    attr_reader fraction: Fraction
    attr_reader expires_at: Integer
    def self.new: (fault fault, Fraction fraction, Integer expires_at) -> Experiment
                | (fault: fault, fraction: Fraction, expires_at: Integer) -> Experiment
    # Whether this has expired by `now`: `now >= expires_at`.
    def spent?: (Integer now) -> bool
  end

  # The core's `Decision::Inject`.
  class Inject < ::Data
    attr_reader fault: fault
    def self.new: (fault fault) -> Inject
                | (fault: fault) -> Inject
  end

  # The core's `Arming::Replaced`: what the slot held before, expired or not,
  # and the runtime's `garbled:` substitute held with it (nil when there was
  # none, and always nil from `Rogue#arm`: the core keeps no substitutes).
  class Replaced < ::Data
    attr_reader experiment: Experiment
    attr_reader garbled: untyped
    def self.new: (Experiment experiment, untyped garbled) -> Replaced
                | (experiment: Experiment, garbled: untyped) -> Replaced
  end

  # The core's `Disarming::Disarmed`: what the slot held, expired or not,
  # and the runtime's `garbled:` substitute removed with it (nil when there
  # was none, and always nil from `Rogue#disarm`: the core keeps no
  # substitutes).
  class Disarmed < ::Data
    attr_reader experiment: Experiment
    attr_reader garbled: untyped
    def self.new: (Experiment experiment, untyped garbled) -> Disarmed
                | (experiment: Experiment, garbled: untyped) -> Disarmed
  end

  type arming = :armed | Replaced | :already_armed
  type disarming = Disarmed | :not_armed

  # The core's `Rogue`. Nothing refuses. Queries judge expiry against the
  # instant they are given and change nothing; only `sweep` empties expired
  # slots. Mutating methods raise FrozenError on a frozen Rogue, and every
  # method raises before changing anything when an argument is malformed.
  class Rogue
    def self.new: () -> Rogue

    # Honoured: :armed (slot was empty), Replaced (it held another
    # experiment), :already_armed (it holds exactly this one; unchanged).
    def arm: (Slot slot, Experiment experiment) -> arming

    # Honoured: Disarmed (what it held), :not_armed (unchanged).
    def disarm: (Slot slot) -> disarming

    # Slots emptied, expired or not; 0 is unchanged.
    def disarm_all: () -> Integer

    # Slots emptied because expired by `now`; 0 is unchanged.
    def sweep: (Integer now) -> Integer

    # Whether any slot holds an experiment, expired or not.
    def any_armed?: () -> bool

    # Slots holding an experiment, expired or not.
    def armed_count: () -> Integer

    # Slots holding an experiment live at `now`.
    def live_count: (Integer now) -> Integer

    # The lowest empty slot, nil when all are held.
    def vacant: () -> Slot?

    # What `slot` holds, expired or not.
    def experiment: (Slot slot) -> Experiment?

    # What `slot` holds if live at `now`.
    def active: (Slot slot, Integer now) -> Experiment?

    # Inject when `slot` holds an experiment live at `now` whose share covers
    # `draw`, else :pass.
    def decide: (Slot slot, Integer now, Draw draw) -> (Inject | :pass)

    # An unfrozen copy holding the same experiments.
    def dup: () -> Rogue

    # A copy, frozen when this is unless `freeze:` says otherwise.
    def clone: (?freeze: bool?) -> Rogue

    def inspect: () -> String
  end

  # Anything that reports monotonic Integer nanoseconds.
  interface _Clock
    def now_ns: () -> Integer
  end

  # Anything that draws below a bound, which `Random` satisfies.
  interface _Random
    def rand: (Integer bound) -> Integer
  end

  # Delegates to `DeadlineMachines.clock` when unset.
  def self.clock: () -> _Clock

  # Disarms everything first: an armed expiry is not meaningful against
  # another clock.
  def self.clock=: (_Clock?) -> void
  def self.random: () -> _Random
  def self.random=: (_Random?) -> void

  # A frozen copy of the runtime's Rogue, taken under the lock, for reading.
  def self.rogue: () -> Rogue

  # Arms `name`, replacing what it held. `share` is a Fraction or a real
  # Numeric in 0..1 rounded to millionths; `expires_in` Integer nanoseconds
  # in 1..LONGEST_EXPERIMENT; a Delay 1..LONGEST_DELAY. Honoured: the core's
  # arming answer for the name's slot, except that :already_armed needs an
  # equal (==) `garbled:` substitute too; a differing one replaces it and
  # answers Replaced holding the experiment. Every Replaced it answers holds
  # the substitute it displaced (nil for none). Refused, unchanged: :full
  # when every slot holds a live experiment. Raises TypeError/RangeError for
  # malformed arguments or clock readings, and Error when the clock was
  # replaced READINGS times while arming; nothing is armed when it raises.
  def self.arm: (Symbol | String name, fault: fault, share: Fraction | Numeric, expires_in: Integer,
                 ?garbled: untyped) -> (arming | :full)

  # Honoured: Disarmed (what the name held, expired or not, with the
  # substitute it removed, nil for none), :not_armed. Takes no reading.
  def self.disarm: (Symbol | String name) -> disarming

  # Experiments held, expired or not; 0 is unchanged.
  def self.disarm_all: () -> Integer

  # With no name, whether anything is live now. Retires expired experiments.
  def self.armed?: (?(Symbol | String)?) -> bool

  # The names live now. Retires expired experiments.
  def self.armed: () -> Array[Symbol]

  # Runs the block, or the fault armed under `name`: raises Injected for
  # :raise, returns the `garbled:` substitute for :garble, waits then runs
  # the block for a Delay (raising `DeadlineMachines::Error` when that spends
  # the ambient budget). Raises TypeError/RangeError for a malformed name,
  # draw or reading.
  def self.run: (Symbol | String name) { () -> untyped } -> untyped

  # Private native hooks behind the Data values: each answers the field as
  # the core holds it, TypeError/RangeError for what the core rejects.
  private def self.__slot: (Integer index) -> Integer
  private def self.__fraction: (Integer millionths) -> Integer
  private def self.__draw: (Integer millionths) -> Integer
  private def self.__delay: (Integer duration) -> Integer
  private def self.__experiment: (fault fault, Fraction fraction, Integer expires_at) -> [fault, Fraction, Integer]
  private def self.__fault: (fault fault) -> fault
  private def self.__held: (Experiment experiment) -> Experiment
  # A Delay's Integer nanoseconds, nil for :raise and :garble.
  private def self.__delay_of: (fault fault) -> Integer?
  private def self.__spent: (Experiment experiment, Integer now) -> bool
  private def self.__covers: (Fraction fraction, Draw draw) -> bool

  # Private runtime helpers. `key` is the checked name as a frozen String.
  private def self.arm_at: (String key, Experiment experiment, untyped payload, Integer now) -> (arming | :full)
  private def self.disarmed: (disarming answer, untyped removed) -> disarming
  private def self.replaced: (arming answer, Experiment experiment, untyped previous, bool same_payload) -> arming
  private def self.decide_at: (String key, Integer now, Draw drawn) -> [Inject | :pass, untyped]
  private def self.retire: (Integer now) -> void
  # `[block's answer]` for a reading against the clock still installed once
  # the lock is held, nil after READINGS attempts.
  private def self.locked_reading: [T] () { (Integer now) -> T } -> [T]?
  # Raises TypeError for a non-Integer reading, RangeError for a negative one.
  private def self.checked_reading: (_Clock source, Integer now) -> nil
  # Raises TypeError for a non-Symbol/String name, RangeError for an empty or
  # illegible one.
  private def self.legible: (Symbol | String name) -> nil
  private def self.named: (Symbol | String name) -> String
  private def self.fraction_of: (Fraction | Numeric share) -> Fraction
  private def self.checked_fault: (fault fault) -> nil
  private def self.span_of: (Integer expires_in) -> Integer
  private def self.perform: (Symbol | String name, fault fault, untyped payload) { () -> untyped } -> untyped
  private def self.stall: (Integer delay_ns) -> void
end
